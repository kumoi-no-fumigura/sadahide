 "poems": [
  {
   "seq": "1",
   "text": "露ふかき野邊のおはなを分ゆけは袖もひとつに月そやとれる",
   "kana": "",
   "speaker": "松田丹後守平貞秀集",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "住吉の岸なる草の其名さへわするはかりに霜かれにけり",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "しかの浦やたかよの月の名殘とて昔なからのかけをみすらん",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "いつるより入まてみるを秋の夜の月には誰かれさめしつらん",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "山河のこほりのひまを行水にたえ〓〓やとる冬のよの月",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "わたの原はるかにみえてかきりなく波の千さとをてらす月影",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "これやこの海にもいてぬしかま河さなからこゆるみつの白浪",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "風をいたみ淺茅か露もなくむしもわかねさめさへ心くたけて",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "冬さむみふけゆくよさの浦風にいくたひわたる千島なくらん",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "夜をさむみ關ふきこゆる秋風にころもうつなりすまのうら人",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "あしかきのこやの池水こほる夜は猶をしとりのなかや隔てん",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "千しほにもあまりてそめよ雨露の惠をうくるよものもみち葉",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "とはれぬをならひと思ふ山さとにいまさら人をまつのしら雪",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "はては又あらしのをともとふ人もまつにたえぬとつもる白雪",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "うつりゆく秋の日數もくれなゐの色とそみゆる峯のもみち葉",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "雖波江やなみもこほりてふる雪になをうつもるゝたま柏かな",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "たこの浦やさこそは富士の陰ならめふらぬ日もなく積る白雪",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "ふみわけて誰かはとはん木葉ちるいまよりのちの冬の山さと",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "箸鷹のおふさのすゝにふりそへて霞たまちるうたの御かりは",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "かくてたに色をやそむる紅葉はのちりしく庭に時雨ふるなり",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "あけぬるかのこる庭火の影なから空にまれなるほしうたふ也",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "晴くもる夜半の時雨やみすもあらすみもせぬ夢の枕すくらん",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "うつりゆく月日のかすも今さらにおとろかれぬる年のくれ哉",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "分わひぬ思ひやかてしるへとはたかゆるしける戀路成らん",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "忍ひきて思ふはかりもいはれぬやなを身にのこる恨なるらん",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "うき人のつらさなからもおなし世にあるを賴むや命なるらん",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "たのましなめにたにみえす吹風の跡なき空のしるへはかりは",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "我袖にありとはしらししのふ山したゆく水にかくるしからみ",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "をはつせの鐘もまちかしすか原○ふしみのさとの夕くれの空",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "涙河せくにつけてやまたるらんかけしよいまは袖のしからみ",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "もるとなき岩やのまへの岩橋も露をくはかりこけむしてけり",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "徒にねをのみたつる笛竹のあなうとたにもいかてしらせん",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "久方の雲井をわけてひゝくなり音さへたかき山のたきつせ",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "あさき瀨にたゝむ筏も末つゐにかよふたよりはありと社きけ",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "通路をたれのこすらん山ふかみ岩ねにつゝくこけのかけはし",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "何故に猶いにしへを忍ふらんありてかはらぬもとのうき鳥は",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "なからへて猶祈りみん戀しなは身のつれなさは神やうくらん",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "つかへつゝ三代にもあひぬ數ならぬ身の思出とこれそ成へき",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "むすひをく契のまゝに下ひものとくるはやすき心ともかな",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "水くきにかきなかしてや〓との葉のみしかき心あらはれもせん",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "今こむとまつ夜もふけぬ逢事はかたふく月のかけになるまて",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "りうひむのにほひも殘るさむしろを誰しきしのふ昔なるらん",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "さもこそはあきき契のすゑならめやかてせたえし中河の水",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "ことしこそ泪に月をやつしつれ置むならひをなにかこちけん",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "なみたにやはや朽はてん限なく身にしきしのふ閨のさむしろ",
   "kana": "",
   "speaker": "",
   "page": 145,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "神かきの冬木の梅のにほひさへ夜のさむきにあらはれにけり",
   "kana": "",
   "speaker": "松田丹後守平貞秀集",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "言の葉にそめし紅葉やのこしけん秋をもまたぬ人のかたみは",
   "kana": "",
   "speaker": "",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "みれは又きり立こめてさゝ波のをとまてとをきおきつしま山",
   "kana": "",
   "speaker": "",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "あまつ風ふきにけらしなたむけ山花の色かもそらにみつまて",
   "kana": "",
   "speaker": "",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "花すゝきたかたまくらとなりにけん結はぬ夢ををしか鳴なり",
   "kana": "",
   "speaker": "",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "わかれこし都の秋のおもかけを月にそのこすまのゝかや原",
   "kana": "",
   "speaker": "「こゝろの月の光なるらん",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "名取河ふかきにしつむ埋木もあさきせよりやあらはれにけん",
   "kana": "",
   "speaker": "",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "あま人のかるてふ袖のみなと田にいなはもさはく秋風そふく",
   "kana": "",
   "speaker": "",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "名にしおふさくらの宮の榊葉にまたかけそふる花のしらゆふ",
   "kana": "",
   "speaker": "",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "山風のおち葉衣をかたしきてれぬ夜やさむき宇治のはし姫",
   "kana": "",
   "speaker": "",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "住よしの神のちかひをまつの葉にかけてそたのむ和歌の浦波",
   "kana": "",
   "speaker": "",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "かさゝきのわたさぬ橋もかつらきや霜夜のかれにあくる空哉",
   "kana": "",
   "speaker": "",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "末つゐにまよひもはてぬやみちとやいく有明の月もいつらん",
   "kana": "",
   "speaker": "",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "わすれしな花と月との名殘まてなにはにみつの春秋のそら",
   "kana": "",
   "speaker": "",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "さりともとたのみをかけて祈る哉あら人神のあらたなる世に",
   "kana": "",
   "speaker": "",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "ふけゆけはあまのいさり火たきすつる跡まてもえてとふ螢哉",
   "kana": "",
   "speaker": "",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "和歌の浦や道おさまれる時をみてあつむる玉は千代の數かも",
   "kana": "",
   "speaker": "",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "難波瀉おなしふるえにたつさきのみの毛もしるき雨のうち哉",
   "kana": "",
   "speaker": "",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "おしからぬ命なりともなからへて人のっらさの限をもみん",
   "kana": "",
   "speaker": "",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "行すゑを月にやたのむあつまのゝ道にくれぬるけふのたひ人",
   "kana": "",
   "speaker": "",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "かくはかり絕ける物をくすかつらくる夜なかけて何恨みけん",
   "kana": "",
   "speaker": "",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "浦人のやかぬしほつの山かせもさゆるみきはに千鳥なくなり",
   "kana": "",
   "speaker": "",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "古へにかくやはありし老て身の何につけても果しうけれは",
   "kana": "",
   "speaker": "",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "さゝれ石のなれるむかしを人とはゝいかゝいはほの磯の松風",
   "kana": "",
   "speaker": "",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "いつとなく人をも身をもうき船のうきてやわたすうちの川長",
   "kana": "",
   "speaker": "",
   "page": 146,
   "pid": "936505",
   "form": "短歌",
   "genre": ""
  }
 ],
